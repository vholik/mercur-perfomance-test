{
  "name": "@mercurjs/integration-tests",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test:unit": "TEST_TYPE=unit jest --rootDir .. --silent=false",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=6144\" jest --silent=false --runInBand --forceExit",
    "test:integration:meilisearch": "TEST_TYPE=integration:http MEILISEARCH_HOST=http://localhost:7700 MEILISEARCH_API_KEY=masterKey NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --testPathPattern=meilisearch"
  },
  "dependencies": {
    "@medusajs/draft-order": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@mercurjs/core": "workspace:*",
    "@mercurjs/magento2-connector-plugin": "workspace:*",
    "jsonwebtoken": "^9.0.3",
    "meilisearch": "^0.59.0",
    "scrypt-kdf": "^2.0.1"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "@medusajs/test-utils": "2.22.3",
    "@medusajs/types": "2.22.3",
    "@mercurjs/types": "workspace:*",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "jest": "^30.2.0",
    "typescript": "5.9.3"
  }
}
